# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_TEMPERATURE=0
OPENAI_FAST=gpt-4o-mini
OPENAI_SMART=gpt-4o
OPENAI_THINKING=o3
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- CMS3 data paths ---
RAW_LOGS_PATH=data/raw/cms3-logs.json
PROCESSED_CHUNKS_PATH=data/processed/cms3_log_chunks.json

# --- Retrieval and reranking ---
RETRIEVER_SUMMARY_K=2
RETRIEVER_EVENT_K=8
RERANK_TOP_N=5
FLASHRANK_MODEL_NAME=ms-marco-TinyBERT-L-2-v2

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=move-mind-ai
PINECONE_NAMESPACE=cms3-logs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_METRIC=cosine
PINECONE_INDEX_HOST=

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=move-mind-ai
# Per-environment projects (optional; fall back to LANGCHAIN_PROJECT when unset)
LANGCHAIN_PROJECT_DEV=move-mind-dev
LANGCHAIN_PROJECT_EVAL=move-mind-eval
LANGCHAIN_PROJECT_PROD=move-mind-prod

# --- PostgreSQL ---
POSTGRES_USER=movemind
POSTGRES_PASSWORD=movemind
POSTGRES_DB=movemind
DATABASE_URL=postgresql://movemind:movemind@localhost:5432/movemind
DATABASE_ASYNC_URL=postgresql+psycopg://movemind:movemind@localhost:5432/movemind

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
RSBUILD_APP_API_URL=http://localhost:8000
