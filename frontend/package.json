    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.3.0",
    "@rsbuild/plugin-react": "^1.3.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "prettier": "^3.5.0",
